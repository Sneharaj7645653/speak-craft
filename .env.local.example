# ─────────────────────────────────────────────────────────────────────────────
# SpeakCraft — Environment Contract
# Copy to `.env.local` and populate from your Supabase project settings.
# ─────────────────────────────────────────────────────────────────────────────

# Public project URL. Safe to expose to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key. Row Level Security is the security boundary, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key. SERVER-ONLY. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Phase 4 AI providers. Both are server-only and optional.
GROQ_API_KEY=
GEMINI_API_KEY=
