{
  "name": "speakcraft",
  "version": "0.1.0",
  "private": true,
  "description": "Asynchronous public-speaking practice platform — Phase 1 (DB, Auth Engine, Layered Backend).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --yes",
    "db:seed": "docker exec -i supabase_db_SpeakCraft psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/seed.sql",
    "db:verify": "tsx scripts/local-db-benchmark.ts",
    "loadtest:setup": "node load-tests/run-local.mjs setup",
    "loadtest:smoke": "node load-tests/run-local.mjs smoke",
    "loadtest:api": "node load-tests/run-local.mjs benchmark",
    "loadtest:cleanup": "node load-tests/run-local.mjs cleanup"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "groq-sdk": "^1.3.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "lighthouse": "^13.6.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
